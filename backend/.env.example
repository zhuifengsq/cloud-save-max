CORS_ORIGINS=["http://localhost:5173"]

REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# Maximum directory levels beneath the shared folder root for episodic tasks.
DRAMA_SYNC_MAX_DEPTH=6

# Pause a directory after 3 complete share listings where it is absent.
DRAMA_FALLBACK_MISSING_LIMIT=3

MEDIA_PROXY_IMAGE_CACHE_ENABLED=true
MEDIA_PROXY_IMAGE_CACHE_TTL_SECONDS=86400
MEDIA_PROXY_IMAGE_CACHE_MAX_FILE_BYTES=10485760
MEDIA_PROXY_IMAGE_CACHE_MAX_TOTAL_BYTES=536870912
# MEDIA_PROXY_IMAGE_CACHE_DIR=./data/cache/proxy_image
